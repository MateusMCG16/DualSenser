# =========================================================================
# DualSenser - .gitignore
# =========================================================================

# -------------------------------------------------------------------------
# Logs & Configurações de Execução Local
# -------------------------------------------------------------------------
Logs/
**/Logs/
*.log
*.log.*
Config/
**/Config/
*.ini

# -------------------------------------------------------------------------
# .NET / C# Build & Artefatos
# -------------------------------------------------------------------------
bin/
obj/
**/bin/
**/obj/
TestResults/
**/TestResults/
[Dd]ebug/
[Rr]elease/
*.suo
*.user
*.userprefs
*.userosscache
*.sln.docstates
*.dll
*.exe
*.pdb
*.cache
*.rsp

# -------------------------------------------------------------------------
# Android & Gradle
# -------------------------------------------------------------------------
.gradle/
**/.gradle/
build/
**/build/
local.properties
.cxx/
**/.cxx/
.externalNativeBuild/
**/.externalNativeBuild/
captures/
.navigation/
*.iml
**/*.iml
.android/

# Android APK / Bundles gerados
*.apk
*.ap_
*.aab
*.dex

# Chaves de Assinatura e Keystores
*.jks
*.keystore
*.key
*.pepk

# -------------------------------------------------------------------------
# Kotlin & JVM
# -------------------------------------------------------------------------
.kotlin/
**/.kotlin/
*.class

# -------------------------------------------------------------------------
# IDEs & Editores (Visual Studio, Android Studio, VS Code, Rider, Fleet)
# -------------------------------------------------------------------------
.vs/
**/.vs/
.idea/
**/.idea/
.fleet/
**/.fleet/
*.swp
*.lock

# VS Code (ignora caches, mantendo configs de tarefas/extensões se existirem)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# -------------------------------------------------------------------------
# Sistema Operacional & Arquivos Temporários
# -------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
~$*
*~
.DS_Store
.AppleDouble
.LSOverride
